```env
# ==========================================
# KRONOS SOCIAL AI — SERVER ENVIRONMENT
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kronos-social-ai

# Authentication
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Frontend URL
# Desarrollo:
CLIENT_URL=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
 
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Gemini specialized models
GEMINI_SCRIPT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_IMAGE_MODEL=
```
